# TiDB Cloud MySQL-compatible connection; use sslMode=VERIFY_IDENTITY.
TIDB_JDBC_URL=jdbc:mysql://YOUR_TIDB_HOST:4000/cryptovault?sslMode=VERIFY_IDENTITY
TIDB_USERNAME=
TIDB_PASSWORD=

# Third-party API credentials (keep these server-side).
COINGECKO_API_KEY=
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=

# Optional email/OTP support.
MAIL_USERNAME=
MAIL_PASSWORD=

# Frontend URL used by payment-provider callbacks.
FRONTEND_BASE_URL=http://localhost:5173

# Optional: comma-separated exact origins, including your Vercel production URL.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:4200,https://crypto-vault-fawn.vercel.app
